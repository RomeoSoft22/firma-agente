<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgenteFirma</RootNamespace>
    <AssemblyName>AgenteFirma</AssemblyName>
    <Version>1.3.0</Version>
    <Product>Agente de Firma Digital</Product>
    <Company>JuarezGonzales</Company>
    <Description>Agente local para firmar documentos PDF con el certificado del usuario</Description>

    <!-- Aplicación de Windows sin consola: vive en la bandeja del sistema. -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>firma.ico</ApplicationIcon>

    <!-- Publicación como un único .exe autocontenido: dotnet publish -c Release -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- iText 7.2 (AGPL): firma PAdES, sello de tiempo, OCSP/CRL y verificación -->
    <PackageReference Include="itext7" Version="7.2.5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="firma.ico" />
  </ItemGroup>

</Project>
